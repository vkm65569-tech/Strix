{
  "name": "strix-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Strix pentest platform: dashboard + GitHub Actions dispatcher on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute strix-platform-db --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute strix-platform-db --local --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.114.0"
  }
}
